{
  "$id": "https://schemas.hermes-flight-recorder.dev/tau3_grounded_generation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tau-3 Grounded Generation Dataset",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "lineage_id",
    "passed",
    "status",
    "blockers",
    "source",
    "files",
    "counts",
    "derivation",
    "artifact_security",
    "row_contract",
    "coverage",
    "sealed_access",
    "contamination",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "hfr.tau3_grounded_generation.v1"},
    "lineage_id": {"const": "tau3-grounded-generation-v1"},
    "passed": {"type": "boolean"},
    "status": {"enum": ["passed", "blocked"]},
    "blockers": {"type": "array", "maxItems": 4096, "items": {"type": "string"}},
    "source": {
      "type": "object",
      "required": ["path_leaf", "sha256", "training_side_only", "accepted_source_families"],
      "properties": {
        "path_leaf": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "training_side_only": {"const": true},
        "accepted_source_families": {"type": "array", "items": {"type": "string"}}
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["train", "validation"],
      "properties": {
        "train": {"$ref": "#/$defs/file"},
        "validation": {"$ref": "#/$defs/file"}
      }
    },
    "counts": {
      "type": "object",
      "required": ["train", "validation"],
      "properties": {
        "train": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "validation": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "derivation": {
      "type": "object",
      "required": [
        "algorithm",
        "dependency_free",
        "training_side_only",
        "replays_tool_methods",
        "fabricates_success_claims",
        "negative_or_unsafe_targets_masked",
        "runtime_derived_system_prompt",
        "ordered_openai_tool_schema_catalog",
        "full_environment_state_replayed",
        "chronological_argument_grounding",
        "policy_confirmation_replayed",
        "policy_mutation_review_replayed",
        "confirmation_detail_grounding_replayed",
        "task_initialization_replayed",
        "ordered_initial_sync_sequence_replayed",
        "initial_sync_sequence_sha256_bound",
        "single_ordered_tool_sequence",
        "scoped_codex_provenance",
        "registered_selection_algorithm",
        "selection_hash_semantics_replayed"
      ],
      "properties": {
        "dependency_free": {"const": true},
        "training_side_only": {"const": true},
        "replays_tool_methods": {"const": true},
        "fabricates_success_claims": {"const": false},
        "negative_or_unsafe_targets_masked": {"const": true},
        "runtime_derived_system_prompt": {"const": true},
        "ordered_openai_tool_schema_catalog": {"const": true},
        "full_environment_state_replayed": {"const": true},
        "chronological_argument_grounding": {"const": true},
        "policy_confirmation_replayed": {"const": true},
        "policy_mutation_review_replayed": {"const": true},
        "confirmation_detail_grounding_replayed": {"const": true},
        "task_initialization_replayed": {"const": true},
        "ordered_initial_sync_sequence_replayed": {"const": true},
        "initial_sync_sequence_sha256_bound": {"const": true},
        "single_ordered_tool_sequence": {"const": true},
        "scoped_codex_provenance": {"const": true},
        "registered_selection_algorithm": {"const": true},
        "selection_hash_semantics_replayed": {"const": true},
        "deterministic_stratified_ordinal_selection": {"const": true},
        "full_rubric_aggregate_replayed": {"const": true},
        "supervised_target_token_count_dependency_free": {"const": true}
      }
    },
    "artifact_security": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "owner_only_required",
        "directory_mode",
        "file_mode",
        "raw_session_publishable"
      ],
      "properties": {
        "classification": {"const": "sensitive"},
        "owner_only_required": {"const": true},
        "directory_mode": {"const": "0700"},
        "file_mode": {"const": "0600_or_stricter"},
        "raw_session_publishable": {"const": false}
      }
    },
    "row_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "state_refs_owner_only",
        "initial_sync_evidence_required",
        "ordered_initial_sync_sequence_required",
        "initial_sync_sequence_sha256_required",
        "per_call_sync_evidence_required",
        "generation_provenance_required",
        "selection_receipt_required",
        "task_initialization_receipt_required",
        "policy_target_review_required",
        "confirmation_detail_grounding_required"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_grounded_generation_row.v1"},
        "state_refs_owner_only": {"const": true},
        "initial_sync_evidence_required": {"const": true},
        "ordered_initial_sync_sequence_required": {"const": true},
        "initial_sync_sequence_sha256_required": {"const": true},
        "per_call_sync_evidence_required": {"const": true},
        "generation_provenance_required": {"const": true},
        "selection_receipt_required": {"const": true},
        "task_initialization_receipt_required": {"const": true},
        "policy_target_review_required": {"const": true},
        "confirmation_detail_grounding_required": {"const": true},
        "scaled_selection_receipt_required": {"const": true},
        "generated_family_binding_required": {"const": true}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["passed", "blockers", "by_split"],
      "properties": {
        "passed": {"type": "boolean"},
        "schema_version": {"type": "string"},
        "blockers": {"type": "array", "maxItems": 4096, "items": {"type": "string"}},
        "blocker_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "blocker_error_id_count": {"type": "integer", "minimum": 0, "maximum": 4096},
        "blocker_records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/blockerRecord"}},
        "nonwaivable_blockers": {"type": "array", "maxItems": 4096, "items": {"type": "string"}, "uniqueItems": true},
        "by_split": {"type": "object"},
        "coverage_profile": {"$ref": "#/$defs/coverageProfile"},
        "token_count_contract": {"$ref": "#/$defs/tokenCountContract"},
        "training_handoff_sha256": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "hash_disjointness": {"$ref": "#/$defs/hashDisjointness"},
        "coverage_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "coverage_profile": {"$ref": "#/$defs/coverageProfile"},
    "training_handoff": {"$ref": "#/$defs/trainingHandoff"},
    "hash_disjointness": {"$ref": "#/$defs/hashDisjointness"},
    "sealed_access": {
      "type": "object",
      "required": ["payload_accessed", "access_count", "materialized_sealed_fields"],
      "properties": {
        "payload_accessed": {"const": false},
        "access_count": {"const": 0},
        "materialized_sealed_fields": {"type": "array", "maxItems": 0}
      }
    },
    "contamination": {
      "type": "object",
      "required": [
        "raw_sealed_payload_read",
        "split_contamination_detected",
        "train_validation_source_hash_disjoint"
      ],
      "properties": {
        "raw_sealed_payload_read": {"const": false},
        "split_contamination_detected": {"const": false},
        "train_validation_source_hash_disjoint": {"const": true}
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "coverage_profile": {
            "properties": {"profile_id": {"const": "tau3_scaled_full_rubric_v1"}},
            "required": ["profile_id"]
          }
        },
        "required": ["coverage_profile"]
      },
      "then": {
        "required": ["coverage_profile", "training_handoff", "hash_disjointness"],
        "properties": {
          "coverage": {
            "required": [
              "schema_version",
              "coverage_profile",
              "passed",
              "blockers",
              "blocker_count",
              "blocker_error_id_count",
              "blocker_records",
              "nonwaivable_blockers",
              "by_split",
              "token_count_contract",
              "training_handoff_sha256",
              "token_balance",
              "telecom_train_example_fraction",
              "training_example_duplication",
              "hash_disjointness",
              "coverage_sha256"
            ]
          }
        }
      }
    }
  ],
  "$defs": {
    "coverageProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "profile_id", "contract_sha256"],
      "properties": {
        "schema_version": {"const": "hfr.tau3_coverage_profile.v1"},
        "profile_id": {"enum": ["tau3_pilot_legacy_v1", "tau3_scaled_full_rubric_v1"]},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "trainingHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "tokenizer", "chat_template", "context_budget", "handoff_sha256"],
      "properties": {
        "schema_version": {"const": "hfr.tau3_training_handoff.v1"},
        "tokenizer": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "revision", "identity_sha256"],
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "revision": {"type": "string", "minLength": 1},
            "identity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "chat_template": {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "sha256"],
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "context_budget": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "handoff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hashDisjointness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "train_source_split",
        "validation_source_split",
        "development_maps_only_to_internal_validation",
        "dimensions",
        "canonical_sha256"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_split_hash_evidence.v1"},
        "train_source_split": {"const": "train"},
        "validation_source_split": {"const": "development"},
        "development_maps_only_to_internal_validation": {"const": true},
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["task_sha256", "source_family_sha256", "prompt_sha256"],
          "properties": {
            "task_sha256": {"$ref": "#/$defs/hashDisjointDimension"},
            "source_family_sha256": {"$ref": "#/$defs/hashDisjointDimension"},
            "prompt_sha256": {"$ref": "#/$defs/hashDisjointDimension"}
          }
        },
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hashDisjointDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "train_row_count",
        "validation_row_count",
        "train_valid_claim_count",
        "validation_valid_claim_count",
        "train_unique_count",
        "validation_unique_count",
        "train_set_sha256",
        "validation_set_sha256",
        "intersection_count",
        "intersection_set_sha256",
        "disjoint",
        "complete"
      ],
      "properties": {
        "train_row_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "validation_row_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "train_valid_claim_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "validation_valid_claim_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "train_unique_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "validation_unique_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "train_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "validation_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "intersection_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "intersection_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "disjoint": {"type": "boolean"},
        "complete": {"type": "boolean"}
      }
    },
    "tokenCountContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "algorithm",
        "canonicalization",
        "counted_unit",
        "admitted_unmasked_canonical_target_only",
        "dependency_free",
        "contract_sha256"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_supervised_target_token_count.v1"},
        "algorithm": {"const": "canonical_json_utf8_byte_tokens_v1"},
        "canonicalization": {"const": "sorted_compact_ascii_json"},
        "counted_unit": {"const": "utf8_byte"},
        "admitted_unmasked_canonical_target_only": {"const": true},
        "dependency_free": {"const": true},
        "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "blockerRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["error_id", "record_sha256"],
      "properties": {
        "error_id": {"type": "string", "pattern": "^E_[A-Z0-9_]+$"},
        "split": {"enum": ["train", "validation"]},
        "domain": {"enum": ["airline", "retail", "telecom"]},
        "dimension": {"type": "string"},
        "identifier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "observed": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "required": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "toolCoverageExemption": {
      "oneOf": [
        {"$ref": "#/$defs/scaledToolCoverageExemption"},
        {"$ref": "#/$defs/legacyToolCoverageExemption"}
      ]
    },
    "legacyToolCoverageExemption": {
      "type": "object",
      "additionalProperties": true,
      "required": ["tool_name", "reason", "reviewer"],
      "properties": {
        "tool_name": {"type": "string", "minLength": 1},
        "reason": {"enum": ["zero_arg", "policy_forbidden"]},
        "reviewer": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"required": ["schema_version"]},
          "then": false
        }
      ]
    },
    "scaledToolCoverageExemption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "domain",
        "tool_name",
        "reason",
        "scope",
        "reviewer",
        "reviewer_artifact_sha256",
        "reviewer_inference_receipt_sha256",
        "reviewer_model",
        "reviewer_reasoning_effort",
        "independent_review",
        "review_artifact",
        "tool_catalog_sha256",
        "policy_hash",
        "evidence_sha256",
        "citation",
        "receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_tool_coverage_exemption.v1"},
        "domain": {"enum": ["airline", "retail", "telecom"]},
        "tool_name": {"type": "string", "minLength": 1},
        "reason": {"enum": ["zero_arg", "policy_forbidden"]},
        "scope": {
          "const": [
            "canonical_argument_payload_count",
            "supervised_target_count"
          ]
        },
        "reviewer": {"type": "string", "minLength": 1},
        "reviewer_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer_inference_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "reviewer_model": {"const": "gpt-5.6-sol"},
        "reviewer_reasoning_effort": {"const": "ultra"},
        "independent_review": {"const": true},
        "review_artifact": {"$ref": "#/$defs/toolCoverageExemptionReview"},
        "tool_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "citation": {"type": "string", "minLength": 1},
        "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "toolCoverageExemptionReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "reviewer",
        "inference_receipt",
        "review_scope",
        "independent_review_pass"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_tool_coverage_exemption_review.v1"},
        "reviewer": {"type": "string", "minLength": 1},
        "inference_receipt": {"$ref": "#/$defs/toolCoverageExemptionReviewInference"},
        "review_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "domain",
            "tool_name",
            "reason",
            "scope",
            "tool_catalog_sha256",
            "policy_hash",
            "evidence_sha256",
            "citation"
          ],
          "properties": {
            "domain": {"enum": ["airline", "retail", "telecom"]},
            "tool_name": {"type": "string", "minLength": 1},
            "reason": {"enum": ["zero_arg", "policy_forbidden"]},
            "scope": {
              "const": [
                "canonical_argument_payload_count",
                "supervised_target_count"
              ]
            },
            "tool_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "citation": {"type": "string", "minLength": 1}
          }
        },
        "independent_review_pass": {"const": true}
      }
    },
    "toolCoverageExemptionReviewInference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "inference_origin",
        "model",
        "reasoning_effort",
        "native_codex_inference_calls",
        "provider_accessed",
        "network_accessed",
        "prohibited_external_model_provider_calls",
        "prohibited_external_network_calls"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_tool_coverage_exemption_review_inference.v1"},
        "inference_origin": {"const": "native_codex"},
        "model": {"const": "gpt-5.6-sol"},
        "reasoning_effort": {"const": "ultra"},
        "native_codex_inference_calls": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "provider_accessed": {"const": true},
        "network_accessed": {"const": true},
        "prohibited_external_model_provider_calls": {"const": 0},
        "prohibited_external_network_calls": {"const": 0}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "mode"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "mode": {"type": "string", "pattern": "^0[246]00$"}
      }
    },
    "generationProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "inference_origin",
        "generator_model",
        "reasoning_effort",
        "native_codex_inference_used",
        "native_codex_inference_calls",
        "provider_accessed",
        "network_accessed",
        "prohibited_external_model_provider_calls",
        "prohibited_external_network_calls",
        "inference_receipt",
        "controller_receipt",
        "inference_receipt_sha256",
        "controller_receipt_sha256",
        "generated_artifacts_redacted",
        "raw_session_publishable",
        "raw_session_owner_only",
        "raw_session_disposition"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_generation_provenance.v2"},
        "inference_origin": {"const": "native_codex"},
        "generator_model": {"const": "gpt-5.6-sol"},
        "reasoning_effort": {"const": "xhigh"},
        "native_codex_inference_used": {"const": true},
        "native_codex_inference_calls": {"type": "integer", "minimum": 1},
        "provider_accessed": {"const": true},
        "network_accessed": {"const": true},
        "prohibited_external_model_provider_calls": {"const": 0},
        "prohibited_external_network_calls": {"const": 0},
        "inference_receipt": {"$ref": "#/$defs/inferenceReceipt"},
        "controller_receipt": {"$ref": "#/$defs/controllerReceipt"},
        "inference_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "controller_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_artifacts_redacted": {"const": true},
        "raw_session_publishable": {"const": false},
        "raw_session_owner_only": {"const": true},
        "raw_session_disposition": {
          "enum": ["not_retained", "retained_owner_only"]
        }
      }
    },
    "inferenceReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "inference_origin",
        "generator_model",
        "reasoning_effort",
        "native_codex_inference_calls",
        "provider_accessed",
        "network_accessed",
        "prohibited_external_model_provider_calls",
        "prohibited_external_network_calls",
        "tau_revision",
        "system_prompt_sha256",
        "tool_catalog_sha256"
      ],
      "properties": {
        "schema_version": {"const": "hfr.tau3_inference_receipt.v1"},
        "inference_origin": {"const": "native_codex"},
        "generator_model": {"const": "gpt-5.6-sol"},
        "reasoning_effort": {"const": "xhigh"},
        "native_codex_inference_calls": {"type": "integer", "minimum": 1},
        "provider_accessed": {"const": true},
        "network_accessed": {"const": true},
        "prohibited_external_model_provider_calls": {"const": 0},
        "prohibited_external_network_calls": {"const": 0},
        "tau_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "system_prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "tool_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "controllerReceipt": {
      "oneOf": [
        {"$ref": "#/$defs/controllerReceiptV1"},
        {"$ref": "#/$defs/controllerReceiptV2"}
      ]
    },
    "controllerReceiptV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "controller_origin",
        "controller_model",
