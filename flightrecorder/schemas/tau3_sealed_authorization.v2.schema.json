{
  "$id": "https://schemas.hermes-flight-recorder.dev/tau3_sealed_authorization.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Public-safe fail-closed authorization for one fresh-custody Tau-3 sealed benchmark.",
  "properties": {
    "schema_version": {"const": "hfr.tau3_sealed_authorization.v2"},
    "created_at": {"minLength": 1, "type": "string"},
    "authorized": {"const": true},
    "hashes_only": {"const": true},
    "local_paths_included": {"const": false},
    "raw_payload_included": {"const": false},
    "candidate_lock": {
      "additionalProperties": false,
      "properties": {
        "benchmark_protocol_lineage_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "benchmark_protocol_signature": {"$ref": "#/$defs/sha256"},
        "created_at": {"minLength": 1, "type": "string"},
        "sealed_access_authorized": {"const": true},
        "sha256": {"$ref": "#/$defs/sha256"},
        "training_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "training_protocol_signature": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "sha256",
        "created_at",
        "training_protocol_sha256",
        "training_protocol_signature",
        "benchmark_protocol_sha256",
        "benchmark_protocol_signature",
        "benchmark_protocol_lineage_sha256",
        "sealed_access_authorized"
      ],
      "type": "object"
    },
    "protocol": {
      "additionalProperties": false,
      "properties": {
        "role": {"const": "fresh_sealed_benchmark"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "signature_sha256": {"$ref": "#/$defs/sha256"},
        "signature_provenance": {"const": "candidate_lock.benchmark_protocol_signature"},
        "tau_revision": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
      },
      "required": ["role", "sha256", "signature_sha256", "signature_provenance", "tau_revision"],
      "type": "object"
    },
    "protocol_lineage": {
      "additionalProperties": false,
      "properties": {
        "benchmark_protocol_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "training_protocol_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["sha256", "training_protocol_sha256", "benchmark_protocol_sha256"],
      "type": "object"
    },
    "blind_custody": {
      "additionalProperties": false,
      "properties": {
        "fresh_contamination_replay_sha256": {"$ref": "#/$defs/sha256"},
        "generator_validation_sha256": {"$ref": "#/$defs/sha256"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "retired_source_incident_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "receipt_sha256",
        "generator_validation_sha256",
        "fresh_contamination_replay_sha256",
        "retired_source_incident_sha256"
      ],
      "type": "object"
    },
    "qualification": {
      "additionalProperties": false,
      "properties": {
        "candidate_selection_report_sha256": {"$ref": "#/$defs/sha256"},
        "qualified_candidate_count": {"minimum": 2, "type": "integer"},
        "qualified_training_evidence_sha256": {"$ref": "#/$defs/sha256"},
        "selected_candidate_id_hash": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "candidate_selection_report_sha256",
        "qualified_training_evidence_sha256",
        "qualified_candidate_count",
        "selected_candidate_id_hash"
      ],
      "type": "object"
    },
    "sealed_source": {
      "additionalProperties": false,
      "properties": {
        "domain_counts": {"$ref": "#/$defs/domainCounts"},
        "hashes_only": {"const": true},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "task_count": {"const": 100}
      },
      "required": ["manifest_sha256", "task_count", "domain_counts", "hashes_only"],
      "type": "object"
    },
    "frozen_contract": {
      "additionalProperties": false,
      "properties": {
        "arms": {"const": ["adapter", "base", "comparator_1", "comparator_2"]},
        "context_window": {"const": 16384},
        "domains": {"const": ["airline", "retail", "telecom"]},
        "harness_sha256": {"$ref": "#/$defs/sha256"},
        "no_test_time_search": {"const": true},
        "prompt_context_decoding_sha256": {"$ref": "#/$defs/sha256"},
        "seeds": {"const": [101, 202, 303, 404]},
        "tool_contract_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "arms",
        "seeds",
        "domains",
        "context_window",
        "tool_contract_sha256",
        "prompt_context_decoding_sha256",
        "harness_sha256",
        "no_test_time_search"
      ],
      "type": "object"
    },
    "model_identity_refs": {
      "additionalProperties": false,
      "properties": {
        "adapter_tree_sha256": {"$ref": "#/$defs/sha256"},
        "base_identity_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_identity_sha256": {"$ref": "#/$defs/sha256"},
        "comparator_1_identity_sha256": {"$ref": "#/$defs/sha256"},
        "comparator_2_identity_sha256": {"$ref": "#/$defs/sha256"},
        "endpoint_model_sha256": {"$ref": "#/$defs/sha256"},
        "equivalence_refs_hash": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "candidate_identity_sha256",
        "adapter_tree_sha256",
        "endpoint_model_sha256",
        "base_identity_sha256",
        "comparator_1_identity_sha256",
        "comparator_2_identity_sha256",
        "equivalence_refs_hash"
      ],
      "type": "object"
    },
    "gates": {
      "additionalProperties": false,
      "properties": {
        "arms_exact": {"const": true},
        "blind_custody_replayed": {"const": true},
        "budget_gate_passed": {"const": true},
        "candidate_lock_valid": {"const": true},
        "chronology_lock_before_authorization": {"const": true},
        "contamination_gate_passed": {"const": true},
        "fresh_domain_balance_passed": {"const": true},
        "fresh_protocol_lineage_replayed": {"const": true},
        "harness_tool_prompt_context_decoding_no_search_identical": {"const": true},
        "license_gate_passed": {"const": true},
        "model_identity_equivalence_refs_present": {"const": true},
        "protocol_binding_valid": {"const": true},
        "public_artifact_contains_no_local_paths": {"const": true},
        "qualified_training_cohort_replayed": {"const": true},
        "redaction_gate_passed": {"const": true},
        "retired_source_not_reused": {"const": true},
        "safety_gate_passed": {"const": true},
        "sealed_source_hash_only": {"const": true},
        "sealed_task_count_is_100": {"const": true},
        "seeds_exact": {"const": true}
      },
      "required": [
        "candidate_lock_valid",
        "chronology_lock_before_authorization",
        "protocol_binding_valid",
        "fresh_protocol_lineage_replayed",
        "blind_custody_replayed",
        "qualified_training_cohort_replayed",
        "retired_source_not_reused",
        "fresh_domain_balance_passed",
        "sealed_source_hash_only",
        "sealed_task_count_is_100",
        "seeds_exact",
        "arms_exact",
        "harness_tool_prompt_context_decoding_no_search_identical",
        "model_identity_equivalence_refs_present",
        "contamination_gate_passed",
        "redaction_gate_passed",
        "license_gate_passed",
        "safety_gate_passed",
        "budget_gate_passed",
        "public_artifact_contains_no_local_paths"
      ],
      "type": "object"
    },
    "budget": {
      "additionalProperties": false,
      "properties": {
        "declared": {"const": true},
        "passed": {"const": true},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["sha256", "declared", "passed"],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "authorized",
    "hashes_only",
    "local_paths_included",
    "raw_payload_included",
    "candidate_lock",
    "protocol",
    "protocol_lineage",
    "blind_custody",
    "qualification",
    "sealed_source",
    "frozen_contract",
    "model_identity_refs",
    "gates",
    "budget"
  ],
  "title": "Tau-3 Sealed Authorization v2",
  "type": "object",
  "$defs": {
    "domainCounts": {
      "additionalProperties": false,
      "properties": {
        "airline": {"minimum": 1, "type": "integer"},
        "retail": {"minimum": 1, "type": "integer"},
        "telecom": {"minimum": 1, "type": "integer"}
      },
      "required": ["airline", "retail", "telecom"],
      "type": "object"
    },
    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  }
}
