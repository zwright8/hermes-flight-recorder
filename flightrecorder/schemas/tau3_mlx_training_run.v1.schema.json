{
  "$id": "https://schemas.hermes-flight-recorder.dev/tau3_mlx_training_run.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Prelaunch or final receipt for a local MLX-LM QLoRA Tau-3 training run.",
  "properties": {
    "adapter": {
      "properties": {
        "path": {
          "$ref": "#/$defs/outputRelativePath"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "adapter_weight_file_count": {
      "minimum": 0,
      "type": "integer"
    },
    "bundle": {
      "type": "object"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/check"
      },
      "type": "array"
    },
    "command": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "config": {
      "type": "object"
    },
    "created_at": {
      "minLength": 1,
      "type": "string"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "type": "number"
    },
    "exit_code": {
      "type": [
        "integer",
        "null"
      ]
    },
    "interrupted": {
      "type": "boolean"
    },
    "losses": {
      "type": "object"
    },
    "mlx_lora_config": {
      "$ref": "#/$defs/outputFileRecord"
    },
    "output_dir": {
      "const": "."
    },
    "peak_child_rss_kb": {
      "minimum": 0,
      "type": "integer"
    },
    "phase": {
      "enum": [
        "prelaunch",
        "final"
      ]
    },
    "prelaunch_receipt": {
      "$ref": "#/$defs/outputFileRecord"
    },
    "process_segments": {
      "description": "Hash-bound exact child-process execution evidence for segmented training.",
      "$ref": "#/$defs/processSegments"
    },
    "schema_checked": {
      "type": "boolean"
    },
    "schema_version": {
      "const": "hfr.tau3_mlx_training_run.v1"
    },
    "telemetry": {
      "additionalProperties": true,
      "properties": {
        "path": {
          "$ref": "#/$defs/outputRelativePath"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "training_binding": {
      "description": "Cryptographic binding for mixture training protocol, local base model identity, dataset provenance, and deterministic recipe.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/trainingBinding"
        }
      ]
    },
    "terminal_status": {
      "enum": [
        "prelaunch",
        "success",
        "crash",
        "timeout",
        "interrupted",
        "oom",
        "no_output"
      ]
    },
    "timed_out": {
      "type": "boolean"
    },
    "weights_updated": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "phase",
    "created_at",
    "bundle",
    "output_dir",
    "command",
    "config",
    "checks",
    "weights_updated",
    "terminal_status"
  ],
  "title": "Hermes Flight Recorder Tau-3 MLX Training Run",
  "type": "object",
  "$defs": {
    "check": {
      "additionalProperties": true,
      "properties": {
        "actual": {},
        "expected": {},
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "passed",
        "actual",
        "expected"
      ],
      "type": "object"
    },
    "outputFileRecord": {
      "additionalProperties": true,
      "properties": {
        "path": {
          "$ref": "#/$defs/outputRelativePath"
        },
        "read_only": {
          "type": "boolean"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "path",
        "read_only",
        "sha256"
      ],
      "type": "object"
    },
    "artifactTree": {
      "additionalProperties": true,
      "properties": {
        "file_count": {
          "minimum": 0,
          "type": "integer"
        },
        "files": {
          "items": {
            "additionalProperties": true,
            "properties": {
              "path": {
                "$ref": "#/$defs/outputRelativePath"
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "size": {
                "minimum": 0,
                "type": "integer"
              }
            },
            "required": [
              "path",
              "sha256",
              "size"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "path": {
          "$ref": "#/$defs/outputRelativePath"
        },
        "tree_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "file_count",
        "files",
        "tree_sha256"
      ],
      "type": "object"
    },
    "processSegmentEntry": {
      "additionalProperties": false,
      "properties": {
        "record": {
          "additionalProperties": true,
          "properties": {
            "adapter_output": {
              "oneOf": [
                {
                  "$ref": "#/$defs/outputFileRecord"
                },
                {
                  "type": "null"
                }
              ]
            },
            "adapter_tree": {
              "$ref": "#/$defs/artifactTree"
            },
            "end_iter": {
              "minimum": 1,
              "type": "integer"
            },
            "index": {
              "minimum": 0,
              "type": "integer"
            },
            "iteration_count": {
              "minimum": 1,
              "type": "integer"
            },
            "optimizer_state_output": {
              "oneOf": [
                {
                  "$ref": "#/$defs/outputFileRecord"
                },
                {
                  "type": "null"
                }
              ]
            },
            "previous_segment_record_sha256": {
              "oneOf": [
                {
                  "$ref": "#/$defs/sha256"
                },
                {
                  "type": "null"
                }
              ]
            },
            "segment_id": {
              "pattern": "^segment-[0-9]{4}$",
              "type": "string"
            },
            "segment_record_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "start_iter": {
              "minimum": 0,
              "type": "integer"
            },
            "telemetry": {
              "$ref": "#/$defs/outputFileRecord"
            },
            "terminal_status": {
              "enum": [
                "success",
                "crash",
                "timeout",
                "oom",
                "no_output"
              ]
            }
          },
          "required": [
            "index",
            "segment_id",
            "start_iter",
            "end_iter",
            "iteration_count",
            "previous_segment_record_sha256",
            "telemetry",
            "adapter_output",
            "adapter_tree",
            "optimizer_state_output",
            "terminal_status",
            "segment_record_sha256"
          ],
          "type": "object"
        },
        "record_file": {
          "$ref": "#/$defs/outputFileRecord"
        }
      },
      "required": [
        "record",
        "record_file"
      ],
      "type": "object"
    },
    "processSegments": {
      "additionalProperties": true,
      "properties": {
        "aggregate_telemetry": {
          "$ref": "#/$defs/outputFileRecord"
        },
        "artifact_tree": {
          "$ref": "#/$defs/artifactTree"
        },
        "completed_segment_count": {
          "minimum": 0,
          "type": "integer"
        },
        "final_adapter": {
          "oneOf": [
            {
              "$ref": "#/$defs/artifactTree"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "$ref": "#/$defs/outputFileRecord"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "plan": {
          "$ref": "#/$defs/outputFileRecord"
        },
        "planned_segment_count": {
          "minimum": 1,
          "type": "integer"
        },
        "plan_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "policy": {
          "additionalProperties": true,
          "properties": {
            "dropout": {
              "const": 0
            },
            "gradient_accumulation": {
              "minimum": 1,
              "type": "integer"
            },
            "process_segment_iters": {
              "minimum": 1,
              "type": "integer"
            },
            "report_every": {
              "minimum": 1,
              "type": "integer"
            },
            "schema_version": {
              "const": "hfr.tau3_mlx_process_segments.v1"
            },
            "total_iters": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "schema_version",
            "total_iters",
            "process_segment_iters",
            "gradient_accumulation",
            "report_every",
            "dropout"
          ],
          "type": "object"
        },
        "policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recovery": {
          "type": "object"
        },
        "schema_version": {
          "const": "hfr.tau3_mlx_process_segments.v1"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/processSegmentEntry"
          },
          "minItems": 1,
          "type": "array"
        },
        "terminal_status": {
          "enum": [
            "success",
            "crash",
            "timeout",
            "oom",
            "no_output"
          ]
        },
        "validation": {
          "additionalProperties": true,
          "properties": {
            "errors": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "passed": {
              "type": "boolean"
            }
          },
          "required": [
            "passed",
            "errors"
          ],
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "policy",
        "policy_sha256",
        "plan",
        "plan_sha256",
        "segments",
        "aggregate_telemetry",
        "artifact_tree",
        "final_adapter",
        "terminal_status",
        "completed_segment_count",
        "planned_segment_count",
        "recovery",
        "manifest_sha256",
        "manifest",
        "validation"
      ],
      "type": "object"
    },
    "protocolSignatureProvenance": {
      "additionalProperties": true,
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "source": {
          "enum": [
            "protocol_manifest.signature",
            "protocol.signature",
            "protocol_file_sha256_content_seal"
          ]
        }
      },
      "required": [
        "source",
        "algorithm"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "trainingBinding": {
      "additionalProperties": true,
      "properties": {
        "protocol": {
          "additionalProperties": true,
          "properties": {
            "protocol_signature": {
              "$ref": "#/$defs/sha256"
            },
            "protocol_signature_provenance": {
              "$ref": "#/$defs/protocolSignatureProvenance"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "sha256",
            "protocol_signature",
            "protocol_signature_provenance"
          ],
          "type": "object"
        }
      },
      "required": [
        "protocol"
      ],
      "type": "object"
    },
    "outputRelativePath": {
      "minLength": 1,
      "not": {
        "anyOf": [
          {
            "pattern": "^/"
          },
          {
            "pattern": "^[A-Za-z]:"
          },
          {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        ]
      },
      "type": "string"
    }
  }
}
