{
  "$id": "https://schemas.hermes-flight-recorder.dev/tau3_behavior_probe_result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tau-3 Behavior Probe Result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "hfr.tau3_behavior_probe_result.v1"},
    "probe_id": {"type": "string", "minLength": 1},
    "family": {
      "type": "string",
      "enum": [
        "formatting",
        "clarification",
        "tool_choice",
        "empty_recovery",
        "error_recovery",
        "repeated_recovery",
        "mutation_confirmation",
        "stopping"
      ]
    },
    "sequence_index": {"type": "integer", "minimum": 0},
    "prompt": {"$ref": "#/$defs/safe_text"},
    "endpoint": {"$ref": "#/$defs/endpoint"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["contains_any", "json_field_equals", "tool_called", "tool_not_called", "no_tool_calls"]
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "tool_calls", "tool_call_count", "transport_error"],
      "properties": {
        "content": {"$ref": "#/$defs/safe_text"},
        "tool_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "name_sha256"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "name_sha256": {"$ref": "#/$defs/sha256"}
            }
          }
        },
        "tool_call_count": {"type": "integer", "minimum": 0},
        "transport_error": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/safe_text"}
          ]
        }
      }
    },
    "expected_outcome": {"$ref": "#/$defs/outcome"},
    "actual_outcome": {"$ref": "#/$defs/outcome"},
    "expected_outcome_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safe_text": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "redacted", "redacted_sha256", "length"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "redacted": {"type": "string"},
        "redacted_sha256": {"$ref": "#/$defs/sha256"},
        "length": {"type": "integer", "minimum": 0}
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url_sha256", "model_sha256", "configuration_sha256"],
      "properties": {
        "base_url_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["passed", "assertions"],
      "properties": {
        "family": {"type": "string"},
        "passed": {"type": "boolean"},
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "passed"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "passed": {"type": "boolean"}
            }
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "probe_id",
    "family",
    "sequence_index",
    "prompt",
    "endpoint",
    "assertions",
    "observation",
    "expected_outcome",
    "actual_outcome",
    "expected_outcome_sha256"
  ]
}
